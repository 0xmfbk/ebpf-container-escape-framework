[Unit]
Description=eBPF EDR Agent
Documentation=file:///usr/share/doc/ebpf-edr/
After=network.target
ConditionPathExists=/sys/kernel/btf/vmlinux
ConditionPathExists=@PREFIX@/lib/ebpf-edr/bpf_program.o

[Service]
# Type=notify + WatchdogSec: the daemon signals READY=1 after attach and
# pings WATCHDOG=1 every 10s; a hung event loop is restarted by systemd.
Type=notify
WatchdogSec=30
ExecStart=@PREFIX@/sbin/ebpf-edr --config /etc/ebpf-edr/config.toml --bpf-obj @PREFIX@/lib/ebpf-edr/bpf_program.o

ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

LimitMEMLOCK=infinity
LimitNOFILE=65536
# A blinded security sensor is worse than no sensor: keep it out of the
# first wave of OOM kills.
OOMScoreAdjust=-500

# CAP_BPF + CAP_PERFMON suffice to load/attach on kernel >= 5.8;
# CAP_SYS_ADMIN covers kprobe attach and bpffs mounts on older kernels.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictNamespaces=yes
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# Deny-by-default syscall allow-list: @system-service covers the Go
# runtime plus file/network/ipc basics; the additions are exactly what
# eBPF loading needs (bpf(), perf_event_open for attach) and @mount for
# bpffs on hosts where /sys/fs/bpf is not pre-mounted.
SystemCallFilter=@system-service @mount bpf perf_event_open
# The daemon uses unix (sd_notify, syslog), internet (webhook/kubelet)
# and netlink sockets; everything else (packet, exotic) is denied.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# eBPF loads via syscalls, not device nodes; systemd's private /dev
# still provides null/zero/urandom which TLS and the runtime need.
PrivateDevices=true

ReadWritePaths=/var/log /sys/fs/bpf
RuntimeDirectory=ebpf-edr
StateDirectory=ebpf-edr
RuntimeDirectoryMode=0750
StateDirectoryMode=0750

MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
