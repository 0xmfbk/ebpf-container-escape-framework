[133.772641, "o", "\u001b[?25l\u001b[22;1H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m 22 \u001b(B\u001b[m\u001b[97;48;5;235m</p>                                                                                                                            \u001b[23;1H\u001b(B\u001b[m\u001b[38;5;248;48;5;235m 23 \u001b(B\u001b[m\u001b[97;48;5;236m                                                                                                                                \u001b[24;5H\u001b(B\u001b[m\u001b[97;48;5;235mAn audit only Linux EDR agent built with eBPF (ker\u001b[24;56Hel\u001b[24;59Hside, C) and a \u001b[25;5Hhigh efficiency Go daemon (user space).\u001b[25;45HTargets Linux ker\u001b[25;63Hel 5.15\u001b[25;71HLTS\u001b[26;5Hand above (\u001b[26;17Hested on Debian 13 / kernel\u001b[26;45H6.12+) with\u001b[26;57HBTF enabled.   \u001b[27;5HEmits structured\u001b[27;22HJSON with full process lineag\u001b[27;52H and cgroup\u001b[27;64Hcontext,\u001b[28;5Hbacked\u001b[28;12Hby\u001b[28;15Ha\u001b[28;17Hzero\u001b[28;22Hallocation\u001b[28;33Hpipeline\u001b[28;42Hand\u001b[28;46Hbounded\u001b[28;54Hcaches.\u001b[29;5H           \u001b[29;17H     \u001b[29;23H   \u001b[29;27H         \u001b[29;37H  \u001b[29;40H     \u001b[29;46H      \u001b[29;53H          \u001b[29;64H      \u001b[29;71H  \u001b[29;74H        \u001b[30;15H\u001b(B\u001b[m\u001b[38;5;235;107m3\u001b[30;17H1\u001b[23;5H\u001b[?12l\u001b[?25h"]
[141.57793, "o", "\u001b[?25l\u001b[1;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m3\u001b[1;5H\u001b(B\u001b[m\u001b[97;48;5;235m<p align=\"center\">                                   \u001b[2;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m4\u001b[2;7H\u001b(B\u001b[m\u001b[97;48;5;235m<a\u001b[2;10Hhref=\"\u001b(B\u001b[m\u001b[38;5;125;48;5;235mhttps://github.com/0xmfbk/ebpf-container-escape-framework/actions/workflows/ci.yml\"\u001b(B\u001b[m\u001b[97;48;5;235m>\u001b[3;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m5\u001b[3;5H\u001b(B\u001b[m\u001b[97;48;5;235m  \u001b[3;8H <\u001b[3;11Hmg src=\"\u001b(B\u001b[m\u001b[38;5;125;48;5;235mhttps://github.com/0xmfbk/ebpf-container-escape-framework/actions/workflows/ci.yml/badge.svg\"\u001b[3;113H\u001b(B\u001b[m\u001b[97;48;5;235malt=\"CI\">\u001b[4;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m6\u001b[4;8H\u001b(B\u001b[m\u001b[97;48;5;235m/a>                                                                                         \u001b[5;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m7\u001b[5;7H\u001b(B\u001b[m\u001b[97;48;5;235m<img src=\"\u001b(B\u001b[m\u001b[38;5;125;48;5;235mhttps://im\u001b[5;28H.s\u001b[5;31Hields.io/badge/Go-1.21%2B-blu\u001b[5;61H\"\u001b(B\u001b[m\u001b[97;48;5;235m alt=\"Go Version\">                                \u001b[5;113H         \u001b[6;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m8\u001b[6;8H\u001b(B\u001b[m\u001b[97;48;5;235mimg\u001b[6;12Hsrc=\"\u001b(B\u001b[m\u001b[38;5;125;48;5;235mhttps://img.shields.io/badge/Kernel-5.15%20LTS%2B-orange\"\u001b[6;75H\u001b(B\u001b[m\u001b[97;48;5;235malt=\"Kernel\u001b[6;87HSupport\">\u001b[7;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m9\u001b[7;46H\u001b(B\u001b[m\u001b[38;5;125;48;5;235mMemory-\u001b[7;54H3C30MB-green\"\u001b(B\u001b[m\u001b[97;48;5;235m alt=\"Mem\u001b[7;77Hry Footprint\">\u001b[8;2H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m10\u001b[8;46H\u001b(B\u001b[m\u001b[38;5;125;48;5;235mLicense-MIT-purple\"\u001b(B\u001b[m\u001b[97;48;5;235m alt