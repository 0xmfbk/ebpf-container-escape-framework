[305.515726, "o", "\u001b[7m# 1. Check that Git sees the new GIF and the README c\u001b[7mh\u001b[7mange\u001b[27m\u001b[K\r\r\n"]
[305.51589, "o", "\u001b[7mgit status\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m# 2. Stage everything\u001b[27m\u001b[K\r\r\n\u001b[7mgit add .\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m# 3. Commit the update\u001b[27m\u001b[K\r\r\n\u001b[7mgit commit -m \"docs: update demo GIF and README hero section for v2.9.0\"\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7m# 4. Push to GitHub\u001b[27m\u001b[K\r\r\n\u001b[7mgit push origin main\u001b[27m\u001b[K"]
[306.207821, "o", "\u001b[11A\u001b[59C\u001b[27m#\u001b[27m \u001b[27m1\u001b[27m.\u001b[27m \u001b[27mC\u001b[27mh\u001b[27me\u001b[27mc\u001b[27mk\u001b[27m \u001b[27mt\u001b[27mh\u001b[27ma\u001b[27mt\u001b[27m \u001b[27mG\u001b[27mi\u001b[27mt\u001b[27m \u001b[27ms\u001b[27me\u001b[27me\u001b[27ms\u001b[27m \u001b[27mt\u001b[27mh\u001b[27me\u001b[27m \u001b[27mn\u001b[27me\u001b[27mw\u001b[27m \u001b[27mG\u001b[27mI\u001b[27mF\u001b[27m \u001b[27ma\u001b[27mn\u001b[27md\u001b[27m \u001b[27mt\u001b[27mh\u001b[27me\u001b[27m \u001b[27mR\u001b[27mE\u001b[27mA\u001b[27mD\u001b[27mM\u001b[27mE\u001b[27m \u001b[27mch\u001b[27ma\u001b[27mn\u001b[27mg\u001b[27me\u001b[1B\r\u001b[27mg\u001b[27mi\u001b[27mt\u001b[27m \u001b[27ms\u001b[27mt\u001b[27ma\u001b[27mt\u001b[27mu\u001b[27ms\u001b[2B\r\u001b[27m#\u001b[27m \u001b[27m2\u001b[27m.\u001b[27m \u001b[27mS\u001b[27mt\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m \u001b[27me\u001b[27mv\u001b[27me\u001b[27mr\u001b[27my\u001b[27mt\u001b[27mh\u001b[27mi\u001b[27mn\u001b[27mg\u001b[1B\r\u001b[27mg\u001b[27mi\u001b[27mt\u001b[27m \u001b[27ma\u001b[27md\u001b[27md\u001b[27m \u001b[27m.\u001b[2B\r\u001b[27m#\u001b[27m \u001b[27m3\u001b[27m.\u001b[27m \u001b[27mC\u001b[27mo\u001b[27mm\u001b[27mm\u001b[27mi\u001b[27mt\u001b[27m \u001b[27mt\u001b[27mh\u001b[27me\u001b[27m \u001b[27mu\u001b[27mp\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[1B\r\u001b[27mg\u001b[27mi\u001b[27mt\u001b[27m \u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mm\u001b[27mi\u001b[27mt\u001b[27m \u001b[27m-\u001b[27mm\u001b[27m \u001b[27m\"\u001b[27md\u001b[27mo\u001b[27mc\u001b[27ms\u001b[27m:\u001b[27m \u001b[27mu\u001b[27mp\u001b[27md\u001b[27ma\u001b[27mt\u001b[27me\u001b[27m \u001b[27md\u001b[27me\u001b[27mm\u001b[27mo\u001b[27m \u001b[27mG\u001b[27mI\u001b[27mF\u001b[27m \u001b[27ma\u001b[27mn\u001b[27md\u001b[27m \u001b[27mR\u001b[27mE\u001b[27mA\u001b[27mD\u001b[27mM\u001b[27mE\u001b[27m \u001b[27mh\u001b[27me\u001b[27mr\u001b[27mo\u001b[27m \u001b[27ms\u001b[27me\u001b[27mc\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27mv\u001b[27m2\u001b[27m.\u001b[27m9\u001b[27m.\u001b[27m0\u001b[27m\"\u001b[2B\r\u001b[27m#\u001b[27m \u001b[27m4\u001b[27m.\u001b[27m \u001b[27mP\u001b[27mu\u001b[27ms\u001b[27mh\u001b[27m \u001b[27mt\u001b[27mo\u001b[27m \u001b[27mG\u001b[27mi\u001b[27mt\u001b[27mH\u001b[27mu\u001b[27mb\u001b[1B\r\u001b[27mg\u001b[27mi\u001b[27mt\u001b[27m \u001b[27mp\u001b[27mu\u001b[27ms\u001b[27mh\u001b[27m \u001b[27mo\u001b[27mr\u001b[27mi\u001b[27mg\u001b[27mi\u001b[27mn\u001b[27m \u001b[27mm\u001b[27ma\u001b[27mi\u001b[27mn"]
