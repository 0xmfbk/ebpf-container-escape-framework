[26;5HEmits structured JSON with full process lineage\u001b[26;53Hand\u001b[26;57Hcgroup\u001b[26;64Hcontext,\u001b[27;5Hbacked by a zero allocation pipeline and bounded caches.                     \u001b[28;5H                                                                                    \u001b[29;5H\u001b(B\u001b[m\u001b[38;5;81;48;5;235m**Status:**\u001b(B\u001b[m\u001b[97;48;5;235m Phase 2.7 complete. 13 MITRE ATT&CK techniques across 15 actions.        \u001b[30;14H\u001b(B\u001b[m\u001b[38;5;235;107m12,1) | ft:markdown | unix | utf-8\u001b[31;1H\u001b(B\u001b[m\u001b[97;48;5;235mPasted\u001b[31;8Hclipboard\u001b[12;5H\u001b[?12l\u001b[?25h"]
[118.301006, "o", "\u001b[?25l\u001b[12;1H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m 12 \u001b(B\u001b[m\u001b[97;48;5;235m                                                                                                                                \u001b[13;1H\u001b(B\u001b[m\u001b[38;5;248;48;5;235m 13 \u001b(B\u001b[m\u001b[97;48;5;236m                                                                                                                                \u001b[14;5H\u001b(B\u001b[m\u001b[97;48;5;235m<p align=\"center\">        \u001b[14;32H          \u001b[14;43H            \u001b[15;5H  <img\u001b[15;12Hsrc=\"docs/demo.gif\"\u001b[15;32Halt=\"Demo\"\u001b[15;43Hwidth=\"800\">\u001b[16;5H</p>\u001b[17;5H                                                   \u001b[18;6H\u001b(B\u001b[m\u001b[38;5;81;48;5;235m **Detection & audit only. Non enforcing sensor.**\u001b(B\u001b[m\u001b[97;48;5;235m      \u001b[18;63H    \u001b[18;68H     \u001b[18;74H  \u001b[18;77H \u001b[19;7H\u001b(B\u001b[m\u001b[38;5;161;48;5;235mNo BPF program returns \u001b(B\u001b[m\u001b[38;5;148;48;5;235m`-EPERM`\u001b(B\u001b[m\u001b[97;48;5;235m; no syscall is blocked.\u001b[19;63HThis\u001b[19;68Hagent\u001b[19;74His\u001b[19;77Ha\u001b[20;7H\u001b(B\u001b[m\u001b[38;5;161;48;5;235mruntime observation plane, not a prevention plane. See\u001b[20;62H\u001b(B\u001b[m\u001b[97;48;5;235m   \u001b[21;9H\u001b(B\u001b[m\u001b[38;5;148;48;5;235mdocs/SECURITY.md`\u001b(B\u001b[m\u001b[97;48;5;235m](docs/SECURITY.md#audit-only-mode)\u001b[21;62Hand\u001b[22;5H\u001b(B\u001b[m\u001b[38;5;161;48;5;235m> [\u001b(B\u001b[m\u001b[38;5;148;48;5;235m`THREAT_MODEL.md`\u001b(B\u001b[m\u001b[97;48;5;235m](THREAT_MODEL.md).\u001b[23;5H  \u001b[23;8H     \u001b[23;14H    \u001b[23;19H     \u001b[23;25H   \u001b[23;29H     \u001b[23;35H     \u001b[23;41H    \u001b[23;46H    \u001b[23;51H       \u001b[23;59H     \u001b[23;65H  \u001b[23;68H   \u001b[23;72H \u001b[24;5HAn audit only Linux EDR agent built with