[117.110469, "o", "\u001b[?25l\u001b[1;5H\u001b(B\u001b[m\u001b[38;5;148;48;5;235m# eBPF Container Escape Detection & Runtime Audit EDR\u001b[3;5H\u001b(B\u001b[m\u001b[97;48;5;236m                                                                                                                                \u001b[4;5H\u001b(B\u001b[m\u001b[97;48;5;235m<p\u001b[4;8Halign=\"center\">\u001b[5;7H<img\u001b[5;12Hsrc=\"docs/demo.gif\"\u001b[5;32Halt=\"Demo\"\u001b[5;43Hwidth=\"800\">\u001b[6;5H</p>\u001b[8;5H\u001b(B\u001b[m\u001b[38;5;161;48;5;235m>\u001b(B\u001b[m\u001b[38;5;81;48;5;235m **Detection & audit only. Non enforcing sensor.**\u001b[9;5H\u001b(B\u001b[m\u001b[38;5;161;48;5;235m> No BPF program returns \u001b(B\u001b[m\u001b[38;5;148;48;5;235m`-EPERM`\u001b(B\u001b[m\u001b[97;48;5;235m;\u001b[9;40Hno\u001b[9;43Hsyscall\u001b[9;51His\u001b[9;54Hblocked.\u001b[9;63HThis\u001b[9;68Hagent\u001b[9;74His\u001b[9;77Ha\u001b[10;5H\u001b(B\u001b[m\u001b[38;5;161;48;5;235m> runtime observation plane, not a prevention plane. See\u001b[11;5H> [\u001b(B\u001b[m\u001b[38;5;148;48;5;235m`docs/SECURITY.md`\u001b(B\u001b[m\u001b[97;48;5;235m](docs/SECURITY.md#audit-only-mode)\u001b[11;62Hand\u001b[12;5H\u001b(B\u001b[m\u001b[38;5;161;48;5;235m> [\u001b(B\u001b[m\u001b[38;5;148;48;5;235m`THREAT_MODEL.md`\u001b(B\u001b[m\u001b[97;48;5;235m](THREAT_MODEL.md).\u001b[14;5HAn\u001b[14;8Haudit\u001b[14;14Honly\u001b[14;19HLinux\u001b[14;25HEDR\u001b[14;29Hagent\u001b[14;35Hbuilt\u001b[14;41Hwith\u001b[14;46HeBPF\u001b[14;51H(kernel\u001b[14;59Hside,\u001b[14;65HC)\u001b[14;68Hand\u001b[14;72Ha\u001b[15;5Hhigh\u001b[15;10Hefficiency\u001b[15;21HGo\u001b[15;24Hdaemon\u001b[15;31H(user\u001b[15;37Hspace).\u001b[15;45HTargets\u001b[15;53HLinux\u001b[15;59Hkernel\u001b[15;66H5.15\u001b[15;71HLTS\u001b[16;5Hand above (tested\u001b[16;23Hon\u001b[16;26HDebian\u001b[16;33H13\u001b[16;36H/\u001b[16;38Hkernel\u001b[16;45H6.12+)\u001b[16;52Hwith\u001b[16;57HBTF\u001b[16;61Henabled.\u001b[17;5HEmits structured\u001b[17;22HJSON\u001b[17;27Hwith\u001b[17;32Hfull\u001b[17;37Hprocess\u001b[17;45Hlineage\u001b[17;53Hand\u001b[17;57Hcgroup\u001b[17;64Hcontext,\u001b[18;5Hbacked by\u001b[18;15Ha\u001b[18;17Hzero\u001b[18;22Hallocation\u001b[18;33Hpipeline\u001b[18;42Hand\u001b[18;46Hbounded\u001b[18;54Hcaches.\u001b[20;5H\u001b(B\u001b[m\u001b[38;5;81;48;5;235m**Status:**\u001b[20;17H\u001b(B\u001b[m\u001b[97;48;5;235mPhase\u001b[20;23H2.7\u001b[20;27Hcomplete.\u001b[20;37H13\u001b[20;40HMITRE\u001b[20;46HATT&CK\u001b[20;53Htechniques\u001b[20;64Hacross\u001b[20;71H15\u001b[20;74Hactions.\u001b[21;5HVerified end \u001b[21;19Ho end\u001b[21;25Hon\u001b[21;28Hkernel\u001b[21;35H6.12.111,\u001b[21;45Hwith\u001b[21;50Hstructural\u001b[21;61Hsupport\u001b[21;69Hfor\u001b[21;73HLinux\u001b[21;79H5.15\u001b[21;84HLTS.\u001b[22;5H     \u001b[22;11H   \u001b[22;15H     \u001b[22;21H    \u001b[22;26H    \u001b[23;5H\u001b(B\u001b[m\u001b[38;5;148;48;5;235m## Coverage\u001b[25;5H\u001b(B\u001b[m\u001b[38;5;81;48;5;235m| # | Action | Severity | MITRE | Hook |\u001b[26;5H\u001b(B\u001b[m\u001b[97;48;5;235m|---|--------|----------|-------|------|\u001b[27;5H\u001b(B\u001b[m\u001b[38;5;81;48;5;235m| 1 | Container_Namespace_Unshare | HIGH | T1611 | kprobe/__x64_sys_unshare |\u001b[28;5H| 2 | Container_Pivot_Root_Escape | CRITICAL | T1611 | kprobe/__x64_sys_pivot_root |\u001b[29;5H| 3 | Sensitive_File_Access | HIGH | T1003.008 | tracepoint/sys_enter_openat + open |\u001b[30;11H\u001b(B\u001b[m\u001b[38;5;235;107m+ (3,1\u001b[3;5H\u001b[?12l\u001b[?25h"]
