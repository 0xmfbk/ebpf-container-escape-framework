[176.038844, "o", "\u001b[?25l\u001b[1;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m1\u001b[1;5H\u001b(B\u001b[m\u001b[38;5;148;48;5;235m# eBPF Container Escape Detection & Runtime Audit EDR\u001b[2;1H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m  2 \u001b(B\u001b[m\u001b[97;48;5;235m                   \u001b[3;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m3\u001b[3;5H\u001b(B\u001b[m\u001b[97;48;5;235m<p align=\"center\">                                                                              \u001b[4;1H\u001b(B\u001b[m\u001b[38;5;248;48;5;235m  4 \u001b[4;7H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m<a href=\"https://github.com/0xmfbk/ebpf-container-\u001b[4;58Hscape-framework/actions/workflows/ci.yml\"> \u001b(B\u001b[m\u001b[97;48;5;235m                      \u001b[5;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m5\u001b[5;7H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m  <img src=\"https://github.com/0xmfbk/ebpf-container-escape-framework/actions/workflows/ci.yml/badge.svg\" alt=\"CI\"> \u001b[6;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m6\u001b[6;8H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m/a>\u001b[6;12H\u001b(B\u001b[m\u001b[97;48;5;235m                                                                     \u001b[7;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m7\u001b[7;46H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mGo-1.21%2B-blue\" alt=\"Go V\u001b[7;73Hrsion\"> \u001b(B\u001b[m\u001b[97;48;5;235m                \u001b[8;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m8\u001b[8;46H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mK\u001b[8;48Hrnel\u001b[8;53H5.15%20LTS%2B-orange\" alt=\"Kernel Support\"> \u001b[9;2H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m 9\u001b[9;46H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mMemory-%3C30MB-gr\u001b[9;64Hen\" alt=\"M\u001b[9;75Hmory Footprint\"> \u001b[10;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m0\u001b[10;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m  <img src=\"https://img.shields.io/badge/License-MIT-purple\" alt=\"License\"> \u001b[11;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m1\u001b[11;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m</p> \u001b[12;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m2\u001b[13;3H3\u001b[13;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m \u001b(B\u001b[m\u001b[97;48;5;235m                                                   \u001b[14;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m4\u001b[14;7H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m**Detecti\u001b[14;17Hn & audit only. Non enforcing sensor.** \u001b(B\u001b[m\u001b[97;48;5;235m                      \u001b[15;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m5\u001b[15;7H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mNo BPF program returns `-EPERM`;\u001b[15;40Hno syscall\u001b[15;51His block\u001b[15;60Hd. This agent is a \u001b[16;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m6\u001b[16;7H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mruntime obs"]
[176.041941, "o", "ervation plane, not a prevention plane. S\u001b[16;60He\u001b[16;62H\u001b(B\u001b[m\u001b[97;48;5;235m    \u001b[17;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m7\u001b[17;9H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mdocs/SECURITY.md`](docs/SECURITY.md#audit-only-mode) and \u001b[18;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m8\u001b[18;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m> [`THREAT_MODEL.md`](THREAT_MODEL.md). \u001b[19;2H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m19\u001b[19;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m \u001b(B\u001b[m\u001b[97;48;5;235m                  \u001b[20;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m0\u001b[20;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m<p align=\"center\"> \u001b(B\u001b[m\u001b[97;48;5;235m                                \u001b[21;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m1\u001b[21;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m  <img src=\"docs/demo.gif\" alt=\"Demo\" width=\"800\"> \u001b[22;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m2\u001b[22;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m</p> \u001b[23;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m3\u001b[23;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m \u001b(B\u001b[m\u001b[97;48;5;235m                                                                    \u001b[24;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m4\u001b[24;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mAn audit only Linux EDR agent built with eBPF (ker\u001b[24;56Hel\u001b[24;59Hside, C) and a \u001b(B\u001b[m\u001b[97;48;5;235m \u001b[25;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m5\u001b[25;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mhigh efficiency Go daemon (user space).\u001b[25;45HTargets Linux ker\u001b[25;63Hel 5.15\u001b[25;71HLTS \u001b[26;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m6\u001b[26;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mand above (\u001b[26;17Hested on Debian 13 / kernel\u001b[26;45H6.12+) with\u001b[26;57HBTF enabled.  \u001b(B\u001b[m\u001b[97;48;5;235m   \u001b[27;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m7\u001b[27;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mEmits structured\u001b[27;22HJSON with full process lineag\u001b[27;52H and cgroup context,  \u001b[28;3H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m8\u001b[28;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7mbacked by a zero allocation pipeline and bounded caches. \u001b[29;2H\u001b(B\u001b[m\u001b[38;5;248;48;5;236m29\u001b[29;5H\u001b(B\u001b[m\u001b[97;48;5;235m\u001b[7m \u001b(B\u001b[m\u001b[97;48;5;235m                                                                             \u001b[30;14H\u001b(B\u001b[m\u001b[38;5;235;107m4\u001b[?25l"]
